GROWW_TOTP_SECRET=
GROWW_REQUEST_TIMEOUT_SECONDS=5

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=trading_system
POSTGRES_USER=trading_system
POSTGRES_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

API_HOST=127.0.0.1
API_PORT=8000
SOURCE_CLOCK_SKEW_SECONDS=5
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
